// Place your key bindings in this file to override the defaultsauto[]
[
  {
    "key": "cmd+[Backslash]",
    "command": "editor.action.commentLine",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "shift+cmd+d",
    "command": "-workbench.view.debug",
    "when": "viewContainer.workbench.view.debug.enabled"
  },
  {
    "key": "alt+right",
    "command": "workbench.action.nextEditorInGroup"
  },
  {
    "key": "alt+left",
    "command": "workbench.action.previousEditorInGroup"
  },
  {
    "command": "runCommands",
    "key": "alt+shift+f",
    "when": "resourceExtname != '.ts' && resourceExtname != '.tsx' ",
    "args": {
      "commands": [
        "editor.action.formatDocument",
        "editor.action.organizeImports"
      ]
    }
  },
  {
    "key": "shift+cmd+d",
    "command": "editor.action.duplicateSelection"
  },
  {
    "key": "cmd+r cmd+t",
    "command": "-workbench.action.selectTheme"
  },
  {
    "key": "cmd+r cmd+t",
    "command": "testing.runCurrentFile",
    "when": "editorTextFocus"
  },
  {
    "key": "shift+cmd+[Comma] f",
    "command": "-testing.runCurrentFile",
    "when": "editorTextFocus"
  },
  {
    "key": "cmd+i",
    "command": "composerMode.agent"
  },
  {
    "key": "alt+cmd+s",
    "command": "workbench.action.toggleUnifiedSidebarFromKeyboard",
    "when": "cursor.agentIdeUnification.enabled == true && !isAuxiliaryWindowFocusedContext"
  },
  {
    "key": "cmd+l",
    "command": "claude-vscode.insertAtMention",
    "when": "editorTextFocus"
  },
  {
    "key": "cmd+l",
    "command": "-composer.sendToAgent",
    "when": "editorHasPromptBar && editorPromptBarFocused"
  },
  { "key": "cmd+shift+l", "command": "-composer.newAgentChat" },
  {
    "key": "cmd+shift+l",
    "command": "claude-vscode.newConversation"
  },
  {
    "key": "ctrl+d",
    "command": "-deleteRight",
    "when": "textInputFocus"
  },
  {
    "key": "cmd+l",
    "command": "-aichat.newchataction",
    "when": "!isGlass"
  },

]
